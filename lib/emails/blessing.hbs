<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>New Blessing — Ifeoma &amp; Michael</title>
  <!--[if mso]>
  <noscript>
    <xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#f4f0eb;font-family:Georgia,'Times New Roman',serif;-webkit-text-size-adjust:100%;mso-line-height-rule:exactly;">

  <!-- Outer wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f0eb;min-width:320px;">
    <tr>
      <td align="center" style="padding:40px 16px 48px;">

        <!-- Card -->
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:6px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.10);">

          <!-- ─── HEADER ─── -->
          <tr>
            <td style="background-color:#1a1a1a;padding:48px 48px 40px;text-align:center;border-bottom:3px solid #EBAC19;">

              <!-- Ornamental top row -->
              <p style="margin:0 0 16px;color:#EBAC19;font-size:13px;letter-spacing:10px;font-family:Georgia,serif;">
                ✦ &nbsp; ✦ &nbsp; ✦
              </p>

              <!-- Names -->
              <h1 style="margin:0 0 10px;color:#ffffff;font-size:46px;font-weight:400;font-style:italic;letter-spacing:2px;line-height:1;font-family:Georgia,'Times New Roman',serif;">
                Ifeoma &amp; Michael
              </h1>

              <!-- Date pill -->
              <p style="margin:0;display:inline-block;color:#1a1a1a;background-color:#EBAC19;font-size:11px;letter-spacing:4px;text-transform:uppercase;padding:5px 18px;border-radius:20px;font-family:Arial,Helvetica,sans-serif;font-weight:700;">
                August 6 · 2026
              </p>

            </td>
          </tr>

          <!-- ─── NOTIFICATION BANNER ─── -->
          <tr>
            <td style="background-color:#EBAC19;padding:14px 48px;text-align:center;">
              <p style="margin:0;color:#1a1a1a;font-size:12px;letter-spacing:5px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;font-weight:700;">
                New Blessing Received
              </p>
            </td>
          </tr>

          <!-- ─── BODY ─── -->
          <tr>
            <td style="padding:44px 48px 16px;">

              <!-- Intro -->
              <p style="margin:0 0 36px;font-size:18px;color:#1a1a1a;line-height:1.6;font-family:Georgia,serif;font-style:italic;">
                Someone just sent you a heartfelt blessing. 🤍
              </p>

              <!-- ── FROM ── -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
                <tr>
                  <td style="border-bottom:1px solid #f0ece6;padding-bottom:20px;">
                    <p style="margin:0 0 5px;font-size:10px;color:#EBAC19;letter-spacing:4px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;font-weight:700;">
                      From
                    </p>
                    <p style="margin:0;font-size:22px;color:#1a1a1a;font-family:Georgia,serif;font-weight:400;">
                      {{name}}
                    </p>
                  </td>
                </tr>
              </table>

              <!-- ── MESSAGE ── -->
              <p style="margin:0 0 10px;font-size:10px;color:#EBAC19;letter-spacing:4px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;font-weight:700;">
                Their Blessing
              </p>

              <!-- Quote block -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:36px;">
                <tr>
                  <!-- Gold left bar -->
                  <td width="4" style="background-color:#EBAC19;border-radius:2px;">&nbsp;</td>
                  <td style="padding:18px 20px;background-color:#faf7f3;border-radius:0 4px 4px 0;">
                    <!-- Opening quote mark -->
                    <p style="margin:0 0 10px;font-size:36px;color:#EBAC19;line-height:1;font-family:Georgia,serif;">&ldquo;</p>
                    <p style="margin:0;font-size:16px;color:#3a3a3a;line-height:1.8;font-family:Georgia,serif;font-style:italic;">
                      {{message}}
                    </p>
                    <p style="margin:8px 0 0;font-size:28px;color:#EBAC19;line-height:1;font-family:Georgia,serif;text-align:right;">&rdquo;</p>
                  </td>
                </tr>
              </table>

              <!-- Approval note -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:8px;">
                <tr>
                  <td style="background-color:#f9f6f2;border-radius:4px;padding:16px 20px;">
                    <p style="margin:0;font-size:13px;color:#888;line-height:1.6;font-family:Arial,Helvetica,sans-serif;">
                      ℹ &nbsp; This blessing is pending your approval in Sanity Studio before it appears on your site.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- ─── DIVIDER ─── -->
          <tr>
            <td style="padding:8px 48px 0;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="height:1px;background:linear-gradient(to right,transparent,#e8e0d4,transparent);font-size:0;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ─── VERSE ─── -->
          <tr>
            <td style="padding:28px 48px 8px;text-align:center;">
              <p style="margin:0 0 6px;font-size:12px;color:#EBAC19;letter-spacing:3px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;font-weight:700;">James 1:17</p>
              <p style="margin:0;font-size:13px;color:#aaa;line-height:1.7;font-family:Georgia,serif;font-style:italic;max-width:380px;margin-inline:auto;">
                Every good and perfect gift is from above, coming down from the Father of the heavenly lights.
              </p>
            </td>
          </tr>

          <!-- ─── FOOTER ─── -->
          <tr>
            <td style="background-color:#1a1a1a;padding:24px 48px;text-align:center;margin-top:8px;">
              <p style="margin:0 0 4px;color:#EBAC19;font-size:13px;letter-spacing:6px;font-family:Georgia,serif;">✦ &nbsp; ✦ &nbsp; ✦</p>
              <p style="margin:0;color:#666;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;">
                Ifeoma &amp; Michael &nbsp;·&nbsp; August 6, 2026
              </p>
            </td>
          </tr>

        </table>
        <!-- /Card -->

      </td>
    </tr>
  </table>

</body>
</html>
